# Resend API key (https://resend.com) — potreban za slanje email-ova sa
# forme za zakazivanje i kontakt forme. Napravite besplatan nalog i
# generišite API key u Resend dashboard-u.
RESEND_API_KEY=

# Adresa sa koje se šalju email-ovi. Dok ne verifikujete sopstveni domen na
# Resend-u, možete koristiti podrazumevanu "MADAuto <onboarding@resend.dev>".
# Nakon verifikacije domena madauto.net, promenite u npr.
# "MADAuto <termini@madauto.net>".
BOOKING_FROM_EMAIL="MADAuto <onboarding@resend.dev>"
